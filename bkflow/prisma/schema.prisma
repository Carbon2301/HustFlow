// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Board {
  id            String @id @default(uuid())
  orgId         String
  title         String
  imageId       String
  imageThumbUrl String @db.Text
  imageFullUrl  String @db.Text
  imageUserName String @db.Text
  imageLinkHTML String @db.Text

  lists   List[]
  members BoardMember[]
  labels  Label[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model List {
  id    String @id @default(uuid())
  title String
  order Int

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  cards Card[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId])
}

model Card {
  id            String    @id @default(uuid())
  title         String
  order         Int
  description   String?   @db.Text
  startDate     DateTime?
  dueDate       DateTime?
  isCompleted   Boolean   @default(false)
  reminder      String?
  reminderSetAt DateTime?

  listId      String
  list        List             @relation(fields: [listId], references: [id], onDelete: Cascade)
  assignees   CardAssignee[]
  comments    CardComment[]
  labels      CardLabel[]
  checklists  Checklist[]
  attachments CardAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listId])
}

model CardAttachment {
  id String @id @default(uuid())

  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  type     AttachmentType
  order    Int            @default(0)
  name     String
  url      String         @db.Text
  fileKey  String?
  fileSize Int?
  mimeType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cardId])
}

enum AttachmentType {
  LINK
  FILE
}

model CardComment {
  id     String @id @default(uuid())
  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  userId    String
  userName  String @db.Text
  userImage String @db.Text
  content   String @db.Text

  parentId String?
  parent   CardComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  CardComment[] @relation("CommentReplies")

  reactions CardCommentReaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cardId])
  @@index([parentId])
  @@index([userId])
}

model CardCommentReaction {
  id        String      @id @default(uuid())
  commentId String
  comment   CardComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  userId String
  emoji  String

  createdAt DateTime @default(now())

  @@unique([commentId, userId, emoji])
  @@index([commentId])
  @@index([userId])
}

enum NOTIFICATION_TYPE {
  CARD_ASSIGNED
  CHECKLIST_ITEM_ASSIGNED
  BOARD_INVITE
  COMMENT_REPLY
  COMMENT_MENTION
  CARD_REMINDER
}

model Notification {
  id              String @id @default(uuid())
  orgId           String
  recipientUserId String

  actorUserId String?
  actorName   String? @db.Text
  actorImage  String? @db.Text

  type    NOTIFICATION_TYPE
  title   String
  message String            @db.Text

  boardId       String?
  boardTitle    String?   @db.Text
  cardId        String?
  cardTitle     String?   @db.Text
  listTitle     String?   @db.Text
  commentId     String?
  dueDate       DateTime?
  triggerTime   DateTime?
  reminderLabel String?
  dedupeKey     String?

  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([recipientUserId, orgId, readAt, createdAt])
  @@index([orgId])
  @@index([boardId])
  @@index([cardId])
  @@index([commentId])
  @@index([dedupeKey])
  @@index([type])
}

model BoardMember {
  id      String @id @default(uuid())
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  userId    String
  userName  String          @db.Text
  userImage String          @db.Text
  userEmail String?         @db.Text
  role      BoardMemberRole @default(MEMBER)

  assignees      CardAssignee[]
  checklistItems ChecklistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([boardId, userId])
  @@index([boardId])
  @@index([userId])
}

enum BoardMemberRole {
  ADMIN
  MEMBER
}

model CardAssignee {
  id            String      @id @default(uuid())
  cardId        String
  card          Card        @relation(fields: [cardId], references: [id], onDelete: Cascade)
  boardMemberId String
  boardMember   BoardMember @relation(fields: [boardMemberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cardId, boardMemberId])
  @@index([cardId])
  @@index([boardMemberId])
}

enum ACTION {
  CREATE
  UPDATE
  DELETE
}

enum ENTITY_TYPE {
  BOARD
  LIST
  CARD
  CHECKLIST
  CHECKLIST_ITEM
}

model AuditLog {
  id          String      @id @default(uuid())
  orgId       String
  cardId      String?
  action      ACTION
  entityId    String
  entityType  ENTITY_TYPE
  entityTitle String
  userId      String
  userImage   String      @db.Text
  userName    String      @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cardId])
}

model OrgLimit {
  id    String @id @default(uuid())
  orgId String @unique
  count Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrgSubscription {
  id    String @id @default(uuid())
  orgId String @unique

  stripeCustomerId       String?   @unique @map(name: "stripe_customer_id")
  stripeSubscriptionId   String?   @unique @map(name: "stripe_subscription_id")
  stripePriceId          String?   @map(name: "stripe_price_id")
  stripeCurrentPeriodEnd DateTime? @map(name: "stripe_current_period_end")
}

model Label {
  id      String      @id @default(uuid())
  boardId String
  board   Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title   String
  color   String
  cards   CardLabel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId])
}

model CardLabel {
  id      String @id @default(uuid())
  cardId  String
  card    Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  labelId String
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cardId, labelId])
  @@index([cardId])
  @@index([labelId])
}

model Checklist {
  id     String          @id @default(uuid())
  cardId String
  card   Card            @relation(fields: [cardId], references: [id], onDelete: Cascade)
  title  String
  order  Int             @default(0)
  items  ChecklistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cardId])
}

model ChecklistItem {
  id          String       @id @default(uuid())
  checklistId String
  checklist   Checklist    @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  title       String
  isCompleted Boolean      @default(false)
  order       Int
  dueDate     DateTime?
  assigneeId  String?
  assignee    BoardMember? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([checklistId])
  @@index([assigneeId])
}
